#!/bin/bash

# Simple walker script to select and launch a TUI
CHOICE=$(printf "🔊 Audio (pulsemixer)\n🌐 Network (wifitui)\n Bluetooth (bluetuith)\n💻 System Monitor (btop)\n📁 Files (yazi)\n📅 Calendar (cal)\n📸 Screenshot (grim+swappy)" | walker --dmenu)

case "$CHOICE" in
*"Audio"*) ghostty --class=com.tui.centered -e pulsemixer ;;
*"Network"*) ghostty --class=com.tui.centered -e wifitui ;;
*"Bluetooth"*) ghostty --class=com.tui.centered -e bluetuith ;;
*"System Monitor"*) ghostty --class=com.tui.centered -e btop ;;
*"Files"*) ghostty --class=com.tui.centered -e yazi ;;
*"Calendar"*) ghostty --class=com.tui.centered --font-size=18 -e calendar.sh ;;
*"Screenshot"*) grim -g "$(slurp)" - | swappy -f - ;;
esac
