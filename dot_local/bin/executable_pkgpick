#!/bin/bash
# Picker for the optional packages in .chezmoidata/packages.yaml.
#   pkgpick          fzf over packages.optional: TAB marks, Enter installs,
#                    ctrl-r removes the marked packages, alt-u / alt-i
#                    toggle showing only uninstalled / installed packages
#                    (ctrl-i would be Tab, hence alt).
#                    Reopens after each action; exits 130 when cancelled
#                    (Esc) so wrappers can skip their pause.
#   pkgpick --drift  list explicitly installed packages that are in neither
#                    packages.core nor packages.optional
#   pkgpick install <pkg>...  install without the picker, then wait for Enter
#                    (used by the walker "packages" menu, which runs it in a
#                    terminal; paru's own prompt is the confirmation)
set -euo pipefail

# fzf `transform` helper for the filter keys: flips the filter recorded in the
# state file (pressing the active filter's key again shows everything) and
# prints the fzf actions that apply it.
if [ "${1:-}" = --toggle ]; then
	mode=$2 dir=$3
	[ "$(cat "$dir/filter")" = "$mode" ] && mode=all
	echo "$mode" >"$dir/filter"
	printf 'reload(cat %s/rows.%s)+change-header(%s)' "$dir" "$mode" "$(pkgpick --header "$mode")"
	exit 0
fi
if [ "${1:-}" = --header ]; then
	h='TAB mark, Enter install, ctrl-r remove, alt-u/alt-i only uninstalled/installed, Esc quit'
	[ "$2" != all ] && h="$h   [showing: $2]"
	echo "$h"
	exit 0
fi

if [ "${1:-}" = install ]; then
	shift
	echo "\$ paru -S --needed $*"
	paru -S --needed "$@" || true
	read -rsp $'\nPress Enter to close' _
	exit 0
fi

data=$(chezmoi data)
core=$(jq -r '.packages.core[][][]' <<<"$data" | sort -u)
optional=$(jq -r '.packages.optional[][][]' <<<"$data" | sort -u)

if [ "${1:-}" = --drift ]; then
	comm -23 <(pacman -Qeq | sort) <(printf '%s\n%s\n' "$core" "$optional" | sort -u)
	exit 0
fi

# Removal guards: optional packages only, must be installed, and no core
# package may depend on it. Then a dry run, then pacman's own prompt.
remove() {
	for p in "$@"; do
		grep -qx "$p" <<<"$optional" || { echo "refusing: $p is not an optional package" >&2; return 1; }
		pacman -Qq "$p" >/dev/null 2>&1 || { echo "refusing: $p is not installed" >&2; return 1; }
		hit=$(comm -12 <(pactree -rl "$p" | sort -u) <(echo "$core"))
		if [ -n "$hit" ]; then
			echo "refusing: core packages depend on $p:" >&2
			echo "$hit" >&2
			return 1
		fi
	done
	sudo pacman -Rs --print "$@"
	sudo pacman -Rs "$@"
}

# Row lists for the picker and its filters live in a temp dir so the fzf
# key bindings (which run outside this shell) can reload them.
dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
echo all >"$dir/filter"

while :; do
	installed=$(pacman -Qq)
	jq -r '.packages.optional | to_entries[] as $m | $m.value | to_entries[] as $g
		| $g.value[] | "\($m.key)\t\($g.key)\t\(.)"' <<<"$data" |
		while IFS=$'\t' read -r mgr grp pkg; do
			if grep -qx "$pkg" <<<"$installed"; then mark="[x]"; else mark="[ ]"; fi
			printf '%s %-6s %-10s %s\t%s\n' "$mark" "$mgr" "$grp" "$pkg" "$pkg"
		done >"$dir/rows.all"
	grep '^\[ \]' "$dir/rows.all" >"$dir/rows.uninstalled" || true
	grep '^\[x\]' "$dir/rows.all" >"$dir/rows.installed" || true
	filter=$(cat "$dir/filter")

	out=$(fzf --multi --layout=reverse --delimiter=$'\t' --with-nth=1 --expect=ctrl-r \
		--header "$(pkgpick --header "$filter")" \
		--bind "alt-u:transform(pkgpick --toggle uninstalled $dir)" \
		--bind "alt-i:transform(pkgpick --toggle installed $dir)" \
		--preview 'paru -Si {2} 2>/dev/null | head -25' --preview-window=right,50% <"$dir/rows.$filter") || exit 130
	key=$(head -1 <<<"$out")
	mapfile -t pkgs < <(tail -n +2 <<<"$out" | cut -f2)
	[ ${#pkgs[@]} -eq 0 ] && exit 130

	if [ "$key" = ctrl-r ]; then
		remove "${pkgs[@]}" || true
	else
		paru -S --needed "${pkgs[@]}" || true
	fi
	read -rsp $'\nPress Enter to return to the picker' _
done
