#!/bin/bash
# browser-here: open a URL in a Firefox window on the current Hyprland
# workspace. Opens a new window if the workspace has none; otherwise focuses
# the existing one so Firefox opens the URL as a tab there.
set -eu

url=$1
browser=firefox-developer-edition

ws=$(hyprctl activeworkspace -j | jq -r .id)
addr=$(hyprctl clients -j | jq -r --argjson ws "$ws" \
  'first(.[] | select(.class == "firefox-developer-edition" and .workspace.id == $ws)) | .address // empty')

if [ -z "$addr" ]; then
  exec "$browser" --new-window "$url"
fi

hyprctl dispatch focuswindow "address:$addr" >/dev/null
sleep 0.2 # let Firefox register the focus so the URL lands in this window
exec "$browser" "$url"
