#!/bin/bash
set -euo pipefail

# Defensive: if mise was installed to a non-standard prefix, its shim dir is
# still on PATH for any downstream tooling that runs from this script.
export PATH="$HOME/.local/share/mise/shims:$PATH"

if ! command -v mise >/dev/null 2>&1; then
	echo "mise not installed; skipping mise install"
	exit 0
fi

# Re-trigger when the mise config changes by embedding its hash.
# config hash: {{ include (joinPath .chezmoi.sourceDir "dot_config/mise/config.toml") | sha256sum }}

mise install
