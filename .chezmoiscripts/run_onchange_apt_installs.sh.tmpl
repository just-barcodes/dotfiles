#!/bin/bash
# Rendered from .chezmoidata/packages.yaml. Edit the YAML, not this script.

set -euo pipefail

{{ if not (or (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelease.id "ubuntu")) -}}
echo "Not running debian/ubuntu... exiting"
exit 0
{{ end -}}

MINIMAL=(
{{ range .packages.apt.minimal }}	{{ . }}
{{ end -}}
)

sudo apt-get update
sudo apt-get install -y "${MINIMAL[@]}"

{{ if default false .aptExtensive -}}
EXTENSIVE=(
{{ range .packages.apt.extensive }}	{{ . }}
{{ end -}}
)

# Add the mise apt repo so `mise` (in EXTENSIVE) installs cleanly.
# https://mise.jdx.dev/installing-mise.html#apt
sudo apt-get install -y ca-certificates gnupg wget
sudo install -dm 755 /etc/apt/keyrings
wget -qO - https://mise.jdx.dev/gpg-key.pub \
	| sudo gpg --dearmor --yes -o /etc/apt/keyrings/mise-archive-keyring.gpg
echo "deb [signed-by=/etc/apt/keyrings/mise-archive-keyring.gpg arch=amd64] https://mise.jdx.dev/deb stable main" \
	| sudo tee /etc/apt/sources.list.d/mise.list > /dev/null
sudo apt-get update

sudo apt-get install -y "${EXTENSIVE[@]}"

# tree-sitter-cli from cargo: the prebuilt binary (mise / apt) needs a recent
# glibc that LTS distros don't have. Cargo builds against the local toolchain.
if ! command -v tree-sitter >/dev/null 2>&1; then
	cargo install tree-sitter-cli
fi
{{ end -}}
