#!/bin/bash
set -euo pipefail

{{ if or (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelease.id "ubuntu") -}}
# zsh and fonts-powerline are installed from the centralized manifest
# (packages.apt.minimal via run_onchange_apt_installs.sh.tmpl).

# Arch installs starship via pacman (see packages.yaml). On Debian/Ubuntu it
# isn't packaged in stable channels, so fall back to the upstream installer.
if ! command -v starship >/dev/null 2>&1; then
	if command -v curl >/dev/null 2>&1; then
		curl -sS https://starship.rs/install.sh | sh -s -- -y
	else
		echo "ERROR: starship installer needs curl" >&2
		exit 1
	fi
fi
{{- end }}
