#!/bin/bash
# Rendered from .chezmoidata/packages.yaml (packages.core.paru). Edit the
# YAML, not this script. Optional AUR packages are never installed here; use
# `pkgpick`.

set -euo pipefail

{{ if not (eq .chezmoi.osRelease.id "arch") -}}
echo "Not running arch... exiting"
exit 0
{{ end -}}

PACKAGES=(
{{ range $_, $pkgs := .packages.core.paru -}}
{{ range $pkgs }}	{{ . }}
{{ end -}}
{{ end -}}
)

paru -S --needed --noconfirm "${PACKAGES[@]}"
