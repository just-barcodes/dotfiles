#!/bin/bash
# Rendered from .chezmoidata/packages.yaml (packages.core.pacman). Edit the
# YAML, not this script. Re-runs whenever the rendered output changes.
# Optional packages are never installed here; use `pkgpick`.

set -euo pipefail

{{ if not (eq .chezmoi.osRelease.id "arch") -}}
echo "Not running arch... exiting"
exit 0
{{ end -}}

{{- $machine := dig "machine" "" . -}}
{{- if eq $machine "" -}}
echo "data.machine is not set; re-run 'chezmoi init' and pick the machine type" >&2
exit 1
{{ end -}}

{{- /* groups referenced by any profile are profile-specific; skip them below */ -}}
{{- $profileGroups := list -}}
{{- range $_, $groups := .profiles }}{{ $profileGroups = concat $profileGroups $groups }}{{ end -}}

PACKAGES=(
{{ range $name, $pkgs := .packages.core.pacman -}}
{{ if not (has $name $profileGroups) }}{{ range $pkgs }}	{{ . }}
{{ end }}{{ end -}}
{{ end -}}
{{ if ne $machine "" }}{{ range (index .profiles $machine) -}}
{{ range (index $.packages.core.pacman .) }}	{{ . }}
{{ end -}}
{{ end }}{{ end -}}
)

# No -y/-u on purpose: full upgrades have their own path. If a new package
# 404s because the sync db is stale, upgrade first and re-apply.
# --asexplicit marks already-installed packages as explicit too, so core
# packages that first arrived as dependencies survive `pacman -Rns` cleanups.
sudo pacman -S --needed --noconfirm --asexplicit "${PACKAGES[@]}"
