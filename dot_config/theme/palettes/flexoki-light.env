# Flexoki Light. See flexoki-dark.env for the colour mapping and
# selenized-dark.env for the format.

pair=flexoki-dark
polarity=light
ghostty_theme="Flexoki Light"
nvim_colorscheme=flexoki-light
# No flexoki in herdr; `terminal` uses ghostty's colours plus the overrides.
herdr_theme=terminal

# bg-2 doubles as the recessed surface: nothing sits above Flexoki's paper.
# bg-2 / bg / ui / ui-3
bg_dim=#f2f0e5
bg_0=#fffcf0
bg_1=#e6e4d9
bg_2=#cecdc3
# tx-2 / base-700 / tx
dim_0=#6f6e69
fg_0=#575653
fg_1=#100f0f

red=#af3029
green=#66800b
yellow=#ad8301
blue=#205ea6
magenta=#a02f6f
cyan=#24837b
orange=#bc5215
violet=#5e409d

br_red=#d14d41
br_green=#879a39
br_yellow=#d0a215
br_blue=#4385be
br_magenta=#ce5d97
br_cyan=#3aa99f
br_orange=#da702c
br_violet=#8b7ec8
