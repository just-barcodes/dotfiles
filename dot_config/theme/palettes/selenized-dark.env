# Selenized Dark. https://github.com/jan-warchol/selenized
#
# Read by three consumers, so the format is deliberately dumb `key=value`:
# `theme-switch` sources it, and (from phase 2) hypr/style.lua and
# quickshell/Theme.qml each parse it with one line of their own.
# Colours need no quoting: an unquoted `#RRGGBB` is a value, not a comment,
# because the `#` is not preceded by whitespace. A value containing a space
# must be quoted, or `source` will try to run the second word as a command.
# All three parsers strip surrounding quotes.
#
# The theme's name is its filename. Do not add a `name=` key here — it would
# be a second source of truth that can disagree with the file it lives in.

pair=selenized-light
polarity=dark
ghostty_theme="Selenized Dark"

# One step recessed from bg_0, for surfaces that sit under it (the bar).
# Selenized defines bg_1/bg_2 as raised, with nothing below bg_0.
bg_dim=#0d3138
bg_0=#103c48
bg_1=#184956
bg_2=#2d5b69
dim_0=#72898f
fg_0=#adbcbc
fg_1=#cad8d9

red=#fa5750
green=#75b938
yellow=#dbb32d
blue=#4695f7
magenta=#f275be
cyan=#41c7b9
orange=#ed8649
violet=#af88eb

br_red=#ff665c
br_green=#84c747
br_yellow=#ebc13d
br_blue=#58a3ff
br_magenta=#ff84cd
br_cyan=#53d6c7
br_orange=#fd9456
br_violet=#bd96fa
