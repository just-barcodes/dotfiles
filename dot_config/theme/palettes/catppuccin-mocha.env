# Catppuccin Mocha. https://github.com/catppuccin/catppuccin
# See selenized-dark.env for the format and its reasoning.

pair=catppuccin-latte
polarity=dark
ghostty_theme="Catppuccin Mocha"
nvim_colorscheme=catppuccin

# mantle / base / surface0 / surface1
bg_dim=#181825
bg_0=#1e1e2e
bg_1=#313244
bg_2=#45475a
# overlay1 / subtext1 / text
dim_0=#7f849c
fg_0=#bac2de
fg_1=#cdd6f4

red=#f38ba8
green=#a6e3a1
yellow=#f9e2af
blue=#89b4fa
magenta=#f5c2e7
cyan=#94e2d5
orange=#fab387
violet=#cba6f7

# Catppuccin has no bright variants.
br_red=#f38ba8
br_green=#a6e3a1
br_yellow=#f9e2af
br_blue=#89b4fa
br_magenta=#f5c2e7
br_cyan=#94e2d5
br_orange=#fab387
br_violet=#cba6f7
