# Flexoki Dark. https://stephango.com/flexoki
# See selenized-dark.env for the format and its reasoning.
#
# Flexoki names its surfaces bg / bg-2 / ui / ui-2 / ui-3 and its text
# tx / tx-2 / tx-3; dark uses the 400 accents, light the 600 ones. The
# bright set follows Ghostty's bundled Flexoki themes, which swap the two.

pair=flexoki-light
polarity=dark
ghostty_theme="Flexoki Dark"
nvim_colorscheme=flexoki-dark

# bg-2 doubles as the recessed surface: nothing sits below Flexoki's black.
# bg-2 / bg / ui / ui-3
bg_dim=#1c1b1a
bg_0=#100f0f
bg_1=#282726
bg_2=#403e3c
# tx-2 / base-300 / tx
dim_0=#878580
fg_0=#b7b5ac
fg_1=#cecdc3

red=#d14d41
green=#879a39
yellow=#d0a215
blue=#4385be
magenta=#ce5d97
cyan=#3aa99f
orange=#da702c
violet=#8b7ec8

br_red=#af3029
br_green=#66800b
br_yellow=#ad8301
br_blue=#205ea6
br_magenta=#a02f6f
br_cyan=#24837b
br_orange=#bc5215
br_violet=#5e409d
