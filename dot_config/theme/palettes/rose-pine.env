# Rosé Pine (main). https://rosepinetheme.com/palette
# See selenized-dark.env for the format and its reasoning.
#
# Terminal mapping follows the official ports: green is pine, blue is foam,
# cyan is rose. There is no orange, so gold stands in for it.

pair=rose-pine-dawn
polarity=dark
ghostty_theme="Rose Pine"
nvim_colorscheme=rose-pine

# Nothing sits below base in the palette; bg_dim is base nudged darker.
bg_dim=#16141f
bg_0=#191724
bg_1=#26233a
bg_2=#403d52
# muted / subtle / text
dim_0=#6e6a86
fg_0=#908caa
fg_1=#e0def4

red=#eb6f92
green=#31748f
yellow=#f6c177
blue=#9ccfd8
magenta=#c4a7e7
cyan=#ebbcba
orange=#f6c177
violet=#c4a7e7

# Rosé Pine has no bright variants.
br_red=#eb6f92
br_green=#31748f
br_yellow=#f6c177
br_blue=#9ccfd8
br_magenta=#c4a7e7
br_cyan=#ebbcba
br_orange=#f6c177
br_violet=#c4a7e7
