# Tokyo Night (night). https://github.com/folke/tokyonight.nvim
# See selenized-dark.env for the format and its reasoning.
#
# Values are from the plugin's extras/lua/tokyonight_night.lua.

pair=tokyo-night-day
polarity=dark
ghostty_theme="TokyoNight Night"
nvim_colorscheme=tokyonight-night
herdr_theme=tokyo-night

