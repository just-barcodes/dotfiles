# Tokyo Night Day. See tokyo-night.env for the source of the values and
# selenized-dark.env for the format.

pair=tokyo-night
polarity=light
ghostty_theme="TokyoNight Day"
nvim_colorscheme=tokyonight-day
herdr_theme=tokyo-night-day

# bg_dark / bg / bg_highlight / terminal black_bright
bg_dim=#d0d5e3
bg_0=#e1e2e7
