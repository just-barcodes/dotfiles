bg_2=#a1a6c5
# comment / fg_dark / fg
dim_0=#848cb5
fg_0=#6172b0
fg_1=#3760bf

red=#f52a65
green=#587539
yellow=#8c6c3e
blue=#2e7de9
magenta=#9854f1
cyan=#007197
orange=#b15c00
