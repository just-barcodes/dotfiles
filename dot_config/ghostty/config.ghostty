theme = Selenized Dark

# Scrollback is a per-surface byte cap (default ~10MB). Byte-capped, so no
# runaway-output risk; 100MB is generous on a modern machine.
scrollback-limit = 100000000

font-size = 12
font-family = "FiraCode Nerd Font"
font-family-bold = "FiraCode Nerd Font"
font-family-italic = "FiraCode Nerd Font"
font-family-bold-italic = "FiraCode Nerd Font"

keybind = ctrl+alt+p=text:\x1b\x10

# Let ctrl+, pass through to the running program (Neovim uses it for
# diagnostic navigation).
keybind = ctrl+,=unbind

